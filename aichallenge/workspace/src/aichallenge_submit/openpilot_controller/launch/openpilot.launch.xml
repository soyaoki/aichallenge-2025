<launch>

  <arg name="openpilot_node_param" default="$(find-pkg-share openpilot_controller)/config/openpilot_controller.param.yaml"/>
  <arg name="use_sim_time" default="true"/>
  <arg name="image_topic" default="/sensing/camera/image_raw"/>
  <arg name="camera_info_topic" default="/sensing/camera/camera_info"/>
  <arg name="control_cmd_topic" default="/control/command/control_cmd"/>
  <arg name="marker_topic" default="/openpilot/debug/markers"/>
  <arg name="trajectory_topic" default="/openpilot/trajectory"/>
  <arg name="model_path" default="$(find-pkg-share openpilot_controller)/models/driving_supercombo.onnx"/>
  <!-- auto | cpu | cuda | tensorrt. docker-compose.gpu.yml sets OPENPILOT_PROVIDER=cuda. -->
  <arg name="provider" default="$(env OPENPILOT_PROVIDER auto)"/>
  <!-- direct_action | trajectory -->
  <arg name="output_mode" default="direct_action"/>
  <!-- base_link, or map when a downstream controller has to follow the trajectory. -->
  <arg name="output_frame" default="base_link"/>
  <!-- Observation only until this is true: markers are published either way. -->
  <arg name="control_enabled" default="false"/>
  <!-- onnxruntime's CUDA provider needs cuDNN 9 plus the CUDA runtime libraries.
       cuDNN 9 lives in an isolated prefix (`make openpilot-gpu-deps`) and must come
       first so it wins over the cuDNN 8 PyTorch pins; the rest are PyTorch's own
       nvidia wheels. Scoped to this node, and harmless when the paths are absent. -->
  <arg name="cudnn_prefix" default="/opt/openpilot-cudnn9/nvidia/cudnn/lib"/>
  <arg name="cuda_lib_prefix" default="/usr/local/lib/python3.10/dist-packages/nvidia"/>
  <let name="cuda_lib_path" value="$(var cuda_lib_prefix)/cublas/lib:$(var cuda_lib_prefix)/cuda_runtime/lib:$(var cuda_lib_prefix)/cuda_nvrtc/lib:$(var cuda_lib_prefix)/cufft/lib:$(var cuda_lib_prefix)/curand/lib:$(var cuda_lib_prefix)/nvjitlink/lib"/>

  <node pkg="openpilot_controller"
        exec="openpilot_controller_node.py"
        name="openpilot_controller_node"
        output="screen">

    <env name="LD_LIBRARY_PATH" value="$(var cudnn_prefix):$(var cuda_lib_path):$(env LD_LIBRARY_PATH '')"/>

    <param from="$(var openpilot_node_param)"/>
    <param name="model.path" value="$(var model_path)"/>
    <param name="model.provider" value="$(var provider)"/>
    <param name="output.mode" value="$(var output_mode)"/>
    <param name="output.frame_id" value="$(var output_frame)"/>
    <param name="control.enabled" value="$(var control_enabled)"/>
    <param name="use_sim_time" value="$(var use_sim_time)"/>
    <remap from="/image_raw" to="$(var image_topic)"/>
    <remap from="/camera_info" to="$(var camera_info_topic)"/>
    <remap from="/control/command/control_cmd" to="$(var control_cmd_topic)"/>
    <remap from="/openpilot/debug/markers" to="$(var marker_topic)"/>
    <remap from="/openpilot/trajectory" to="$(var trajectory_topic)"/>
  </node>

</launch>
