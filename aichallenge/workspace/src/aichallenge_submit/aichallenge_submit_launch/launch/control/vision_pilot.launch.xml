<?xml version="1.0" encoding="UTF-8"?>
<launch>
  <arg name="use_sim_time" default="true"/>
  <node pkg="vision_pilot_adapter" exec="vision_pilot_adapter_node"
        name="vision_pilot_adapter" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
  <node pkg="vision_pilot" exec="vision_pilot_node"
        name="vision_pilot" output="screen">
    <param name="use_sim_time" value="$(var use_sim_time)"/>
  </node>
</launch>
